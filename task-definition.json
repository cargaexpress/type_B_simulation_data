{
  "family": "carrier-type-b-simulator-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "containerDefinitions": [
    {
      "name": "gateway",
      "image": "carrier-b-gateway:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ]
    },
    {
      "name": "carrier-a",
      "image": "carrier-b-carrier-a:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8001,
          "hostPort": 8001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "8001"
        },
        {
          "name": "RATE_LIMIT_PER_MINUTE",
          "value": "60"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgresql+psycopg://carrier_a_user:0000@carrier_a_db:5432/carrier_a_db"
        }
      ]
    },
    {
      "name": "carrier-b",
      "image": "carrier-b-carrier-b:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8002,
          "hostPort": 8002,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "8002"
        },
        {
          "name": "RATE_LIMIT_PER_MINUTE",
          "value": "60"
        },
        {
          "name": "DATABASE_URL",
          "value": "mysql+pymysql://carrier_b_user:0000@carrier_b_db:3306/carrier_b_db"
        }
      ]
    },
    {
      "name": "carrier-c",
      "image": "carrier-b-carrier-c:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8003,
          "hostPort": 8003,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "8003"
        },
        {
          "name": "RATE_LIMIT_PER_MINUTE",
          "value": "60"
        },
        {
          "name": "MONGODB_URL",
          "value": "mongodb://carrier_c_admin:0000@carrier_c_db:27017/carrier_c_db?authSource=admin"
        },
        {
          "name": "MONGODB_DATABASE",
          "value": "carrier_c_db"
        }
      ]
    },
    {
      "name": "carrier-d",
      "image": "carrier-b-carrier-d:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8004,
          "hostPort": 8004,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "8004"
        },
        {
          "name": "RATE_LIMIT_PER_MINUTE",
          "value": "60"
        },
        {
          "name": "DATABASE_URL",
          "value": "sqlite:////data/carrier_d.sqlite3"
        }
      ]
    }
  ]
}
